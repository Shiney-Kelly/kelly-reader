# editor settings that make android studio format code the way CLAUDE.md asks
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.bat]
end_of_line = crlf

[*.md]
# two trailing spaces can mean a line break in markdown
trim_trailing_whitespace = false

[{*.kt,*.kts,*.py}]
# 120 is the hard limit, the guide line at 100 marks the soft limit
max_line_length = 120
ij_visual_guides = 100

[{*.kt,*.kts}]
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

# no wildcard imports at all, and one ascii sorted block
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset
ij_kotlin_imports_layout = *

# trailing comma on any list broken over several lines
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
